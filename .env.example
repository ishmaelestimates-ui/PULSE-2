DATABASE_URL=postgresql://user:pass@localhost:5432/pulse
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-1.5-pro
SECRET_KEY=change-me-to-a-random-32-plus-character-secret
ENVIRONMENT=development
RESOLVE_FRAME_RATE=24.0

# --- Night 2: media upload + transcription ---
MEDIA_STORAGE_PATH=./media
MAX_UPLOAD_SIZE_MB=2048

# TRANSCRIPTION_PROVIDER: "gemini" (uses GEMINI_API_KEY above) or "whisper"
# (uses OPENAI_API_KEY below, via OpenAI's hosted Whisper API)
TRANSCRIPTION_PROVIDER=gemini
OPENAI_API_KEY=your-openai-key-here
WHISPER_MODEL=whisper-1

# --- Night 4: color grading + brand settings ---
GEMINI_VISION_MODEL=gemini-1.5-pro
LUTS_DIR=app/assets/luts
# Keep this inside MEDIA_STORAGE_PATH if you change that above.
USER_LUTS_DIR=./media/luts

# --- Sprint 6: PR module + Postiz + Reddit distribution ---
# Self-hosted Postiz instance base URL (not the /public/v1 path — that's
# appended automatically). See https://docs.postiz.com/public-api
POSTIZ_URL=http://localhost:3000
POSTIZ_API_KEY=your-key-here
# Only needed if you build out direct Reddit OAuth later (e.g. for live
# karma polling) — not required for the subreddit search/analyze
# endpoints, which use Reddit's public read-only API.
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USER_AGENT=PULSE/1.0 (podcast production tool)

# --- Sprint 8: user management ---
# SECRET_KEY (above) signs session tokens. No email provider is
# integrated — magic links/invites are logged server-side (and, in
# development only, returned directly in the API response) rather than
# actually emailed.
MAX_USERS=8
SESSION_TOKEN_TTL_HOURS=168
MAGIC_LINK_TTL_MINUTES=15
INVITE_TTL_DAYS=7
# First admin, created automatically on first startup if no users exist.
# Set a real password here before first run in anything but local dev —
# otherwise a random one is generated and printed ONCE to the server log.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
